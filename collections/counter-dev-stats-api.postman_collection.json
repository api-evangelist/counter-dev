        {
          "id": "87a5e9eb-3749-4df5-8231-3054e4ab5af5",
          "name": "Query archived stats for a date range.",
          "request": {
            "name": "Query archived stats for a date range.",
            "description": {
              "content": "Returns aggregated, archived visit data for the authenticated account over a date range as JSON. Authentication is by session cookie or by a user + token pair (sessionless, read-only). When demo=1 the magic demo account is queried instead.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "(Required) Start date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "(Required) End date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "user",
                  "value": "<string>",
                  "description": "Account user id, for sessionless (token) access."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Read-only API token for sessionless access (paired with user)."
                },
                {
                  "disabled": false,
                  "key": "demo",
                  "value": "<string>",
                  "description": "Set to 1 to query the public demo account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "3e345f3b-5e21-44a3-a2ab-d46ff2abf501",
              "name": "Aggregated archive data for the requested range.",
              "originalRequest": {
