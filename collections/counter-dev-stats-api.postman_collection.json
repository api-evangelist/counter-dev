        {
          "id": "f015ee73-3aff-4065-a783-8b4d50db732e",
          "name": "Stream live and archived stats (Server-Sent Events).",
          "request": {
            "name": "Stream live and archived stats (Server-Sent Events).",
            "description": {
              "content": "Opens a text/event-stream (Server-Sent Events) connection that pushes an initial archive payload and then live \"dump\" payloads (per-site counts, logs, and aggregated visits) as new visits arrive. Authenticated by session cookie, by user + token (sessionless), or via demo. This is the data feed the dashboard UI consumes; it is one-way HTTP streaming, not WebSocket.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dump"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "utcoffset",
                  "value": "<string>",
                  "description": "Client UTC offset for day/hour bucketing."
                },
                {
                  "disabled": false,
                  "key": "user",
                  "value": "<string>",
                  "description": "Account user id, for sessionless (token) access."
                },
                {
                  "disabled": false,
                  "key": "token",
                  "value": "<string>",
                  "description": "Read-only API token for sessionless access (paired with user)."
                },
                {
                  "disabled": false,
                  "key": "demo",
                  "value": "<string>",
                  "description": "Set to a non-empty value to stream the public demo account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e2a47249-e099-422a-9785-8ba25bcbbaae",
              "name": "Server-Sent Events stream of typed payloads (oldest-archive-date, archive, dump, nouser).",
