      "item": [
        {
          "id": "0bd04d2e-d288-4a39-815d-8a494503ce85",
          "name": "Record an aggregated visit.",
          "request": {
            "name": "Record an aggregated visit.",
            "description": {
              "content": "Called by the tracking snippet ~4.5s after load, once per tab (guarded by a sessionStorage flag). Records a single aggregated visit for the site identified by the data-id. Requires an Origin header (used to derive the site id). No cookies are set and no IP address is stored; country may be supplied explicitly or derived from the CF-IPCountry header. Bots and localhost origins are ignored.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "track"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Site data-id (per-account cached UUID). Either id, user, or site must be provided."
                },
                {
                  "disabled": false,
                  "key": "user",
                  "value": "<string>",
                  "description": "Account user id, used when id is not supplied."
                },
                {
                  "disabled": false,
                  "key": "site",
                  "value": "<string>",
                  "description": "Legacy alias for the user/account id, supported for backward compatibility."
                },
                {
                  "disabled": false,
                  "key": "referrer",
                  "value": "<string>",
                  "description": "Document referrer URL; only the host is retained."
                },
                {
                  "disabled": false,
                  "key": "screen",
                  "value": "<string>",
                  "description": "Screen resolution as WIDTHxHEIGHT (bucketed to known resolutions or \"Other\")."
                },
                {
                  "disabled": false,
                  "key": "utcoffset",
                  "value": "<string>",
                  "description": "Client UTC offset, used to bucket the visit into the correct local day/hour."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "Two-letter country code; if omitted the CF-IPCountry header is used."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c87bdbff-0f13-4e26-8f79-122b5f743cac",
              "name": "Visit recorded. Body is the plain text \"OK\".",
